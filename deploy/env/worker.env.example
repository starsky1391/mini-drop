# 每台 Worker 各复制一份为 worker.env。
AGENT_ID=linux-worker-1
AGENT_IP_ADDR=10.0.0.21
AGENT_GRPC_ADDR=10.0.0.10:50051
AGENT_HEARTBEAT_INTERVAL_SEC=5
# 证书 SAN 与连接地址不一致时才填写，例如 control.internal。
AGENT_GRPC_TLS_SERVER_NAME=

MINI_DROP_GRPC_TOKEN=CHANGE_ME_SHARED_RANDOM_GRPC_TOKEN

MINIO_ENDPOINT=http://10.0.0.10:9000
MINIO_ACCESS_KEY=mini_drop_worker
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET
MINIO_BUCKET=mini-drop
MINIO_SECURE=0

# Managed Collector Profile：默认由 worker compose 托管工业采集 sidecar。
# 普通部署不需要每次任务配置采集器；Agent 会自动发现这些默认来源并上报能力状态。
MINI_DROP_MANAGED_COLLECTORS=1
MINI_DROP_LOG_AUTO_DISCOVER=1
MINI_DROP_LOG_PATHS=/host/var/log/*.log,/host/var/lib/docker/containers/*/*.log
MINI_DROP_LOG_PIPELINE_OUTPUT=/var/lib/mini-drop/logs/logs.ndjson
MINI_DROP_TRACE_PATHS=/var/lib/mini-drop/traces
MINI_DROP_OFFCPU_PROFILE_PATHS=/var/lib/mini-drop/profiles/offcpu
MINI_DROP_EBPF_PROFILE_ENABLED=1
MINI_DROP_BLACKBOX_URL=http://blackbox-exporter:9115
MINI_DROP_OTEL_COLLECTOR_GRPC_ENDPOINT=otel-collector:4317
MINI_DROP_OTEL_COLLECTOR_HTTP_ENDPOINT=http://otel-collector:4318

# Redis 是可选增强。需要 Redis 专项证据时，用 profile 启动：
# docker compose --profile redis --env-file deploy/env/worker.env -f docker-compose.worker.yml up -d --build
# MINI_DROP_REDIS_ADDR=redis://redis:6379
# MINI_DROP_REDIS_PASSWORD=
# MINI_DROP_REDIS_EXPORTER_URL=http://redis-exporter:9121/metrics
