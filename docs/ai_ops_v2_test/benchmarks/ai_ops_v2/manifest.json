    {"case_id": "OB-COMPOUND-OOM-RECOVERY-001", "track": "live_compound_fault"},
    {"case_id": "OB-COMPOUND-CROSS-WORKER-001", "track": "live_compound_fault"},
    {"case_id": "OB-COMPOUND-PAYMENT-REDIS-001", "track": "live_compound_fault"},
    {"case_id": "OB-COMPOUND-STALE-REAL-001", "track": "live_compound_fault"},
    {"case_id": "OB-NEG-HEALTHY-001", "track": "negative_and_robustness"},
