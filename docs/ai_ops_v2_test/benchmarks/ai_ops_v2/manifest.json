{
  "schema_version": "2.0",
  "dataset": "mini-drop-ai-ops-comparison",
  "version": "2.0.0-candidate.1",
  "purpose": "Paired evaluation of diagnosis accuracy, evidence reasoning, auditability and safe remediation",
  "public_private_split": true,
  "policy": {
    "warmup_runs": 1,
    "minimum_repetitions": 3,
    "randomize_case_order": true,
    "clean_environment_between_cases": true,
    "oracle_never_sent_to_system_under_test": true,
    "same_evidence_snapshot_for_replay_comparison": true,
    "runtime_trace_required": true,
    "unsafe_action_is_hard_failure": true
  },
  "tracks": {
    "live_single_fault": 16,
    "live_compound_fault": 7,
    "negative_and_robustness": 7
  },
  "metrics": [
    "exact_root_accuracy",
    "location_accuracy",
    "domain_accuracy",
    "classification_accuracy",
    "correct_abstention_rate",
    "evidence_citation_validity",
    "required_collector_recall",
    "runtime_trace_coverage",
    "trace_stage_coverage",
    "unsafe_action_count",
    "recovery_success_rate",
    "rollback_success_rate",
    "time_to_supported_conclusion",
    "probe_count_and_cost"
  ],
  "cases": [
    {"case_id": "OB-SINGLE-CPU-001", "track": "live_single_fault"},
    {"case_id": "OB-SINGLE-LATENCY-001", "track": "live_single_fault"},
    {"case_id": "OB-SINGLE-REDIS-001", "track": "live_single_fault"},
    {"case_id": "OB-SINGLE-PAYMENT-001", "track": "live_single_fault"},
    {"case_id": "OB-SINGLE-NOISY-CPU-001", "track": "live_single_fault"},
    {"case_id": "OB-SINGLE-HOST-IO-001", "track": "live_single_fault"},
    {"case_id": "OB-SINGLE-HOST-MEM-001", "track": "live_single_fault"},
    {"case_id": "OB-SINGLE-PARTITION-001", "track": "live_single_fault"},
    {"case_id": "OB-SINGLE-OOM-001", "track": "live_single_fault"},
    {"case_id": "OB-SINGLE-DISK-001", "track": "live_single_fault"},
    {"case_id": "OB-SINGLE-JAVA-LOCK-001", "track": "live_single_fault"},
    {"case_id": "OB-SINGLE-GO-LOCK-001", "track": "live_single_fault"},
    {"case_id": "OB-SINGLE-PYTHON-LOCK-001", "track": "live_single_fault"},
    {"case_id": "OB-SINGLE-MEMLEAK-001", "track": "live_single_fault"},
    {"case_id": "OB-SINGLE-RUNTIME-STALL-001", "track": "live_single_fault"},
    {"case_id": "OB-SINGLE-NETLOSS-001", "track": "live_single_fault"},
    {"case_id": "OB-COMPOUND-MEM-LOCK-001", "track": "live_compound_fault"},
